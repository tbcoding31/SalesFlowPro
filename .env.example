# ── SalesFlow Pro — Frontend Environment Variables ──
#
# Copy this file to .env and fill in the values.
#
# IMPORTANT: Variables prefixed with VITE_* are embedded into the frontend
# bundle at build time. They are NOT secret — treat them as publicly accessible.

# Gemini API Key (currently unused by the application)
# If used, this would be embedded in the frontend bundle and visible to users.
GEMINI_API_KEY=your_gemini_api_key_here

# Application URL (set by deployment platform)
APP_URL=http://localhost:3100
