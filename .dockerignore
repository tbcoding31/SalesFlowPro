*.cjs
*.sh
*.patch
scratch/
docs/
*.txt
*.sql

# IDE and OS
.vscode
.idea
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Misc
FETCH_HEAD
bun.lock
.antigravity
assets
