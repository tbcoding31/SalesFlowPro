> opportunities.reduce((acc, curr) => acc + (curr.estimatedValue * (curr.probability / 100)), 0), [opportunities]);  const totalWon = useMemo(() => opportunities.filter(o => o.stage === \'WON\').reduce((acc, curr) => acc + curr.estimatedValue, 0), [opportunities]);  const formatMoney = (val: number) => {    return new Intl.NumberFormat(\'id-ID\', {      style: \'currency\',      currency: \'IDR\',      minimumFractionDigits: 0,      maximumFractionDigits: 0    }).format(val);  };  const formatSummary = (val: number) => {    if (val >= 1000000000) return `Rp ${(val / 1000000000).toFixed(1)}B`;    if (val >= 1000000) return `Rp ${(val / 1000000).toFixed(1)}M`;    return formatMoney(val);  };  const handleDragStart = (e: DragEvent<HTMLDivElement>, oppId: string) => {    setDraggedOppId(oppId);    e.dataTransfer.effectAllowed = \'move\';    e.dataTransfer.setData(\'text/plain\', oppId);    setTimeout(() => {      const el = document.getElementById(`opp-card-${oppId}`);      if (el) el.classList.add(\'opacity-50\');    }, 0);  };  const handleDragEnd = (e: DragEvent<HTMLDivElement>, oppId: string) => {    setDraggedOppId(null);    const el = document.getElementById(`opp-card-${oppId}`);    if (el) el.classList.remove(\'opacity-50\');  };  const handleDragOver = (e: DragEvent<HTMLDivElement>) => {    e.preventDefault();    e.dataTransfer.dropEffect = \'move\';  };  const handleDrop = (e: DragEvent<HTMLDivElement>, targetStage: OpportunityStage) => {    e.preventDefault();    const oppId = e.dataTransfer.getData(\'text/plain\');    if (!oppId) return;    const opp = opportunities.find(o => o.id === oppId);    if (!opp || opp.stage === targetStage) return;    const oldStageLabel = stages.find(s => s.key === opp.stage)?.label || opp.stage;    const newStageLabel = stages.find(s => s.key === targetStage)?.label || targetStage;    const updatedOpp = { ...opp, stage: targetStage, updatedAt: new Date().toISOString() };    DataService.saveOpportunity(updatedOpp);        const activity = {      tenantId: opp.tenantId,      customerId: opp.customerId,      customerName: opp.customerName,      userId: currentUser?.id || \'SYS-001\',      userName: currentUser?.name || \'System\',      type: \'OPPORTUNITY\' as ActivityType,      subject: `Opportunity Stage Updated: ${targetStage}`,      description: `Opportunity \"${opp.name}\" was moved from ${oldStageLabel} to ${newStageLabel}.`,      occurredAt: new Date().toISOString(),      entityType: \'OPPORTUNITY\',      entityId: opp.id    };    DataService.addActivity(activity);    setOpportunities(DataService.getOpportunities(tenantId));  };  // List View Filtering  const filteredList = useMemo(() => {    return opportunities.filter(opp => {      if (searchTerm) {        const term = searchTerm.toLowerCase();        if (!opp.name.toLowerCase().includes(term) && !opp.customerName.toLowerCase().includes(term)) {          return false;        }      }      if (stageFilter !== \'ALL\' && opp.stage !== stageFilter) return false;"
    }
