      full: "import React, { useState } from \'react\';import { useAuth } from \'../../context/AuthContext\';import { DataService } from \'../../services/dataService\';import { FollowUp } from \'../../types\';export const FollowupsPage: React.FC = () => {  const { currentTenant } = useAuth();  const tenantId = currentTenant?.id || \'TEN-00001\';  const [followups, setFollowups] = useState<FollowUp[]>(DataService.getFollowUps(tenantId));  const [typeFilter, setTypeFilter] = useState<string>(\'ALL\');  const filtered = followups.filter(    (f) => typeFilter === \'ALL\' || f.type === typeFilter  );  const toggleComplete = (id: string) => {    const item = followups.find((f) => f.id === id);    if (item) {      const updated: FollowUp = {        ...item,        status: item.status === \'COMPLETED\' ? \'PENDING\' : \'COMPLETED\',      };      DataService.saveFollowUp(updated);      setFollowups(DataService.getFollowUps(tenantId));    }  };  return (    <div className=\"space-y-6 font-[\'Inter\',sans-serif]\">      {/* Header */}      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-xl border border-[#E1E1E1] shadow-sm\">        <div>          <div className=\"flex items-center gap-2\">            <span className=\"px-2.5 py-0.5 bg-[#4744e5]/10 text-[#4744e5] text-xs font-bold rounded uppercase\">              Sales Cadence            </span>          </div>          <h1 className=\"text-2xl font-bold text-[#1a1c1c] font-[\'Hanken_Grotesk\'] mt-1\">            Follow-Up Calls, Emails & Client Touchpoints          </h1>          <p className=\"text-xs text-[#464555] mt-0.5\">            Log client calls, email dispatches, and WhatsApp messages with reminder notifications.          </p>        </div>      </div>      {/* Filter Bar */}      <div className=\"bg-white p-4 rounded-xl border border-[#E1E1E1] shadow-sm flex justify-between items-center gap-4\">        <div className=\"flex items-center gap-3\">          <label className=\"text-xs font-bold text-[#464555]\">Communication Channel:</label>          <select            value={typeFilter}            onChange={(e) => setTypeFilter(e.target.value)}            className=\"border border-[#E1E1E1] rounded-lg text-xs px-3 py-1.5 bg-white font-semibold text-[#1a1c1c]\"          >            <option value=\"ALL\">All Channels</option>            <option value=\"CALL\">Phone Call</option>            <option value=\"EMAIL\">Email Dispatch</option>            <option value=\"WHATSAPP\">WhatsApp</option>            <option value=\"MEETING\">In-Person Meeting</option>          </select>        </div>        <div className=\"text-xs text-[#767587]\">          Showing <span className=\"font-bold text-[#1a1c1c]\">{filtered.length}</span> follow-ups        </div>      </div>      {/* Followups List Table */}      <div className=\"bg-white rounded-xl border border-[#E1E1E1] shadow-sm overflow-hidden\">        <div className=\"overflow-x-auto\">          <table className=\"w-full text-left text-xs text-[#1a1c1c]\">            <thead className=\"bg-[#f9f9f9] text-[#464555] font-bold uppercase border-b border-[#E1E1E1]\">              <tr>                <th className=\"px-6 py-3.5 w-12 text-center\">Done</th>                <th className=\"px-6 py-3.5\">Channel</th>                <th className=\"px-6 py-3.5\">Subject & Notes</th>                <th className=\"px-6 py-3.5\">Customer Account</th>                <th className=\"px-6 py-3.5\">Assigned PIC</th>                <th className=\"px-6 py-3.5\">Scheduled Date</th>                <th className=\"px-6 py-3.5\">Status</th>              </tr>            </thead>            <tbody className=\"divide-y divide-[#E1E1E1]\">              {filtered.length === 0 ? (                <tr>                  <td colSpan={7} className=\"text-center py-12 text-[#767587] text-xs\">                    No follow-ups recorded for selected channel.                  </td>                </tr>              ) : (                filtered.map((f) => (                  <tr key={f.id} className=\"hover:bg-[#f9f9f9]\">                    <td className=\"px-6 py-4 text-center\">                      <input                        type=\"checkbox\"                        checked={f.status === \'COMPLETED\'}                        onChange={() => toggleComplete(f.id)}                        className=\"w-4 h-4 rounded text-[#4744e5] cursor-pointer\"                      />                    </td>                    <td className=\"px-6 py-4 font-bold\">                      <span className=\"px-2 py-0.5 bg-[#eff4ff] text-[#4744e5] text-[10px] rounded uppercase font-bold\">                        {f.type}                      </span>                    </td>                    <td className=\"px-6 py-4\">                      <span                        className={`font-bold text-sm block ${                          f.status === \'COMPLETED\' ? \'line-through text-[#767587]\' : \'text-[#1a1c1c]\'                        }`}                      >                        {f.subject}                      </span>                      <span className=\"text-[11px] text-[#767587]\">{f.notes}</span>                    </td>                    <td className=\"px-6 py-4 font-bold text-[#4744e5]\">                      {f.customerName}                    </td>                    <td className=\"px-6 py-4 font-medium\">{f.picName}</td>                    <td className=\"px-6 py-4 font-semibold text-[#1a1c1c]\">{f.scheduledDate}</td>                    <td className=\"px-6 py-4\">                      <span                        className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold ${                          f.status === \'COMPLETED\'                            ? \'bg-[#00C875]/10 text-[#008f53]\'                            : \'bg-[#6161ff]/10 text-[#6161ff]\'                        }`}                      >                        {f.status}                      </span>                    </td>                  </tr>                ))              )}            </tbody>          </table>        </div>      </div>    </div>  );};"
    }
    command_line: "cat src/pages/followups/FollowupsPage.tsx"
    proposed_command_line: "cat src/pages/followups/FollowupsPage.tsx"
    shell_name: "bash"
  }
}
