          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <span className=\"material-symbols-outlined text-[48px] opacity-20\">group</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <p className=\"text-sm font-medium\">No team tasks found matching your criteria.</p>"
