lg text-xs font-semibold transition-colors ${\n                            isActive\n                              ? \'bg-[#6161ff] text-white\'\n                              : \'text-[#464555] hover:bg-[#f3f3f3] hover:text-[#1a1c1c]\'\n                          }`\n                        }\n                      >\n                        Team Tasks\n                      </NavLink>\n                    )}\n\n                    <NavLink\n                      to=\"/task-board\"\n                      className={({ isActive }) =>\n                        `block px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${\n                          isActive\n                            ? \'bg-[#6161ff] text-white\'\n                            : \'text-[#464555] hover:bg-[#f3f3f3] hover:text-[#1a1c1c]\'\n                        }`\n                      }\n                    >\n                      Task Board\n                    </NavLink>\n                  </div>\n                </div>"
