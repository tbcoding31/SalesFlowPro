          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    <tr key={t.id} className={`hover:bg-[#fcfcfd] transition-colors group ${isCompleted ? \'bg-slate-50/50\' : \'\'}`}>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
