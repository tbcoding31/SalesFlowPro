          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              style={{ width: currentStageIndex >= 0 ? `${(currentStageIndex / (pipelineStages.length - 1)) * 100}%` : \'0%\' }}"
