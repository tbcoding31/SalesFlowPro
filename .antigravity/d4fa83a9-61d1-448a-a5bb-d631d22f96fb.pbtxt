        }
        lines {
          text: "                          className={`px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-md ${"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            t.priority === \'URGENT\' ? \'bg-rose-100 text-rose-700\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
