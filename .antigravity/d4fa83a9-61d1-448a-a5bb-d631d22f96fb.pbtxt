        target_content: "  const handleCancelSubmit = () => {\n    setCurrentStatus(\'CANCELLED\');\n    const updated = { ...visit, status: \'CANCELLED\' as VisitStatus, notes: `[Cancelled: ${cancelReason}] ${visit.notes || \'\'}` };\n    DataService.saveVisit(updated);\n    setVisitList(DataService.getVisits(tenantId));\n    setIsCancelModalOpen(false);\n    setActivityHistory([\n      ...activityHistory,\n      { id: Date.now().toString(), date: new Date().toLocaleString(), user: currentUser?.name || \'User\', action: `Cancelled visit: ${cancelReason}` },\n    ]);\n    showToast(\'Visit has been cancelled.\');\n  };\n\n  const handleCompleteAndSubmitReport = () => {\n    setCurrentStatus(\'COMPLETED\');\n    const updated = {\n      ...visit,\n      status: \'COMPLETED\' as VisitStatus,\n      result: reportResult,\n      nextAction: reportNextAction,\n    };\n    DataService.saveVisit(updated);\n    setVisitList(DataService.getVisits(tenantId));\n    setIsReportModalOpen(false);\n    setActivityHistory([\n      ...activityHistory,\n      { id: Date.now().toString(), date: new Date().toLocaleString(), user: currentUser?.name || \'User\', action: \'Completed visit and submitted report\' },\n    ]);\n    showToast(\'Visit completed and report submitted successfully!\');\n  };"
