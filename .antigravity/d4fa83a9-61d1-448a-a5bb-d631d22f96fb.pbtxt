        lines {
          text: "                      className={`transition-colors group ${"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        isSelected ? \'bg-indigo-50/50\' : "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        isCompleted ? \'bg-slate-50/50\' : \'hover:bg-[#fcfcfd]\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      }`}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
