          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <td className=\"px-5 py-4\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        <div className=\"font-semibold text-[#1a1c1c]\">{t.customerName || \'-\'}</div>"
