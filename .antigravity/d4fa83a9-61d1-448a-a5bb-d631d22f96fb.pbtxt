          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          {new Date(t.dueDate).toLocaleDateString(\'en-GB\', { day: \'numeric\', month: \'short\', year: \'numeric\' })}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
