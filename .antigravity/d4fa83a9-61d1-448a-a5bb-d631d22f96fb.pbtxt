  run_command {
    cwd: "."
    exit_code: 0
    blocking: true
    wait_ms_before_async: 5000
    command_line: "cat << \'EOF\' > src/pages/opportunities/OpportunitiesPage.tsx\nimport React, { useState, useMemo, DragEvent } from \'react\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { DataService } from \'../../services/dataService\';\nimport { Opportunity, OpportunityStage, ActivityType, Customer } from \'../../types\';\n\ntype ViewMode = \'PIPELINE\' | \'LIST\';\n\nexport const OpportunitiesPage: React.FC = () => {\n  const { currentTenant, currentUser } = useAuth();\n  const tenantId = currentTenant?.id || \'TEN-00001\';\n\n  const [opportunities, setOpportunities] = useState<Opportunity[]>(DataService.getOpportunities(tenantId));\n  const [customers] = useState<Customer[]>(DataService.getCustomers(tenantId));\n  const [viewMode, setViewMode] = useState<ViewMode>(\'LIST\');\n  const [draggedOppId, setDraggedOppId] = useState<string | null>(null);\n\n  // Filters for List View\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [stageFilter, setStageFilter] = useState<string>(\'ALL\');\n  const [customerFilter, setCustomerFilter] = useState<string>(\'ALL\');\n  \n  // List View Pagination & Selection\n  const [currentPage, setCurrentPage] = useState(1);\n  const itemsPerPage = 10;\n  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());\n\n  const stages: { key: OpportunityStage; label: string; color: string }[] = [\n    { key: \'LEAD\', label: \'Prospect\', color: \'border-slate-300\' },\n    { key: \'QUALIFICATION\', label: \'Qualification\', color: \'border-blue-300\' },\n    { key: \'PROPOSAL\', label: \'Proposal\', color: \'border-indigo-300\' },\n    { key: \'NEGOTIATION\', label: \'Negotiation\', color: \'border-amber-300\' },\n    { key: \'WON\', label: \'Won\', color: \'border-emerald-300\' },\n    { key: \'LOST\', label: \'Lost\', color: \'border-rose-300\' },\n  ];\n\n  // Summaries\n  const totalPipeline = useMemo(() => opportunities.reduce((acc, curr) => acc + curr.estimatedValue, 0), [opportunities]);\n  const weightedPipeline = useMemo(() => opportunities.reduce((acc, curr) => acc + (curr.estimatedValue * (curr.probability / 100)), 0), [opportunities]);\n  const totalWon = useMemo(() => opportunities.filter(o => o.stage === \'WON\').reduce((acc, curr) => acc + curr.estimatedValue, 0), [opportunities]);\n\n  const formatMoney = (val: number) => {\n    return new Intl.NumberFormat(\'id-ID\', {\n      style: \'currency\',\n      currency: \'IDR\',\n      minimumFractionDigits: 0,\n      maximumFractionDigits: 0\n    }).format(val);\n  };\n\n  const formatSummary = (val: number) => {\n    if (val >= 1000000000) return `Rp ${(val / 1000000000).toFixed(1)}B`;\n    if (val >= 1000000) return `Rp ${(val / 1000000).toFixed(1)}M`;\n    return formatMoney(val);\n  };\n\n  const handleDragStart = (e: DragEvent<HTMLDivElement>, oppId: string) => {\n    setDraggedOppId(oppId);\n    e.dataTransfer.effectAllowed = \'move\';\n    e.dataTransfer.setData(\'text/plain\', oppId);\n    setTimeout(() => {\n      const el = document.getElementById(`opp-card-${oppId}`);\n      if (el) el.classList.add(\'opacity-50\');\n    }, 0);\n  };\n\n  const handleDragEnd = (e: DragEvent<HTMLDivElement>, oppId: string) => {\n    setDraggedOppId(null);\n    const el = document.getElementById(`opp-card-${oppId}`);\n    if (el) el.classList.remove(\'opacity-50\');\n  };\n\n  const handleDragOver = (e: DragEvent<HTMLDivElement>) => {\n    e.preventDefault();\n    e.dataTransfer.dropEffect = \'move\';\n  };\n\n  const handleDrop = (e: DragEvent<HTMLDivElement>, targetStage: OpportunityStage) => {\n    e.preventDefault();\n    const oppId = e.dataTransfer.getData(\'text/plain\');\n    if (!oppId) return;\n\n    const opp = opportunities.find(o => o.id === oppId);\n    if (!opp || opp.stage === targetStage) return;\n\n    const oldStageLabel = stages.find(s => s.key === opp.stage)?.label || opp.stage;\n    const newStageLabel = stages.find(s => s.key === targetStage)?.label || targetStage;\n\n    const updatedOpp = { ...opp, stage: targetStage, updatedAt: new Date().toISOString() };\n    DataService.saveOpportunity(updatedOpp);\n    \n    const activity = {\n      tenantId: opp.tenantId,\n      customerId: opp.customerId,\n      customerName: opp.customerName,\n      userId: currentUser?.id || \'SYS-001\',\n      userName: currentUser?.name || \'System\',\n      type: \'OPPORTUNITY\' as ActivityType,\n      subject: `Opportunity Stage Updated: ${targetStage}`,\n      description: `Opportunity \"${opp.name}\" was moved from ${oldStageLabel} to ${newStageLabel}.`,\n      occurredAt: new Date().toISOString(),\n      entityType: \'OPPORTUNITY\',\n      entityId: opp.id\n    };\n    DataService.addActivity(activity);\n\n    setOpportunities(DataService.getOpportunities(tenantId));\n  };\n\n  // List View Filtering\n  const filteredList = useMemo(() => {\n    return opportunities.filter(opp => {\n      if (searchTerm) {\n        const term = searchTerm.toLowerCase();\n        if (!opp.name.toLowerCase().includes(term) && !opp.customerName.toLowerCase().includes(term)) {\n          return false;\n        }\n      }\n      if (stageFilter !== \'ALL\' && opp.stage !== stageFilter) return false;\n      if (customerFilter !== \'ALL\' && opp.customerId !== customerFilter) return false;\n      return true;\n    });\n  }, [opportunities, searchTerm, stageFilter, customerFilter]);\n\n  const totalPages = Math.ceil(filteredList.length / itemsPerPage);\n  const paginatedList = filteredList.slice((currentPage - 1) * itemsPerPage, currentPage * itemsPerPage);\n\n  const toggleSelectAll = () => {\n    if (selectedIds.size === paginatedList.length) {\n      setSelectedIds(new Set());\n    } else {\n      setSelectedIds(new Set(paginatedList.map(o => o.id)));\n    }\n  };\n\n  const toggleSelect = (id: string) => {\n    const newSet = new Set(selectedIds);\n    if (newSet.has(id)) newSet.delete(id);\n    else newSet.add(id);\n    setSelectedIds(newSet);\n  };\n\n  const getStageBadge = (stage: OpportunityStage) => {\n    switch (stage) {\n      case \'LEAD\': return <span className=\"px-2 py-0.5 bg-slate-100 text-slate-700 text-[10px] font-bold rounded uppercase tracking-wider\">Prospect</span>;\n      case \'QUALIFICATION\': return <span className=\"px-2 py-0.5 bg-blue-100 text-blue-700 text-[10px] font-bold rounded uppercase tracking-wider\">Qualification</span>;\n      case \'PROPOSAL\': return <span className=\"px-2 py-0.5 bg-indigo-100 text-indigo-700 text-[10px] font-bold rounded uppercase tracking-wider\">Proposal</span>;\n      case \'NEGOTIATION\': return <span className=\"px-2 py-0.5 bg-amber-100 text-amber-700 text-[10px] font-bold rounded uppercase tracking-wider\">Negotiation</span>;\n      case \'WON\': return <span className=\"px-2 py-0.5 bg-emerald-100 text-emerald-700 text-[10px] font-bold rounded uppercase tracking-wider\">Won</span>;\n      case \'LOST\': return <span className=\"px-2 py-0.5 bg-rose-100 text-rose-700 text-[10px] font-bold rounded uppercase tracking-wider\">Lost</span>;\n      default: return null;\n    }\n  };\n\n  return (\n    <div className={`space-y-6 font-[\'Inter\',sans-serif] flex flex-col ${viewMode === \'PIPELINE\' ? \'h-[calc(100vh-80px)] min-h-[600px]\' : \'\'}`}>\n      \n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 shrink-0\">\n        <div>\n          <h1 className=\"text-2xl font-extrabold text-[#1a1c1c] font-[\'Hanken_Grotesk\'] tracking-tight\">\n            Opportunities\n          </h1>\n          <p className=\"text-xs text-[#767587] mt-0.5\">\n            Manage your opportunities and track revenue across the sales process.\n          </p>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <div className=\"bg-slate-100 p-1 rounded-xl flex items-center border border-slate-200\">\n            <button \n              onClick={() => setViewMode(\'LIST\')}\n              className={`px-3 py-1.5 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 ${viewMode === \'LIST\' ? \'bg-white text-[#1a1c1c] shadow-sm\' : \'text-slate-500 hover:text-[#1a1c1c]\'}`}\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">list</span>\n              List\n            </button>\n            <button \n              onClick={() => setViewMode(\'PIPELINE\')}\n              className={`px-3 py-1.5 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 ${viewMode === \'PIPELINE\' ? \'bg-white text-[#1a1c1c] shadow-sm\' : \'text-slate-500 hover:text-[#1a1c1c]\'}`}\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">view_kanban</span>\n              Pipeline\n            </button>\n          </div>\n          <button className=\"px-4 py-2 bg-white border border-[#E1E1E1] text-[#464555] hover:bg-slate-50 text-xs font-extrabold rounded-xl shadow-2xs transition-colors flex items-center gap-1.5 cursor-pointer\">\n            <span className=\"material-symbols-outlined text-[18px]\">download</span>\n            Export\n          </button>\n          <button className=\"px-4 py-2 bg-[#4744e5] hover:bg-[#322fce] text-white text-xs font-extrabold rounded-xl shadow-xs transition-colors flex items-center gap-1.5 cursor-pointer\">\n            <span className=\"material-symbols-outlined text-[18px]\">add</span>\n            New Opportunity\n          </button>\n        </div>\n      </div>\n\n      {/* Summary Row */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 shrink-0\">\n        <div className=\"bg-white p-5 rounded-2xl border border-[#E1E1E1] shadow-2xs flex items-center justify-between\">\n          <div>\n            <div className=\"text-[10px] font-extrabold text-[#767587] uppercase tracking-wider mb-1\">Total Pipeline</div>\n            <div className=\"text-2xl font-extrabold text-[#1a1c1c]\">{formatSummary(totalPipeline)}</div>\n          </div>\n          <div className=\"w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center\">\n            <span className=\"material-symbols-outlined\">monitoring</span>\n          </div>\n        </div>\n        <div className=\"bg-white p-5 rounded-2xl border border-[#E1E1E1] shadow-2xs flex items-center justify-between\">\n          <div>\n            <div className=\"text-[10px] font-extrabold text-[#767587] uppercase tracking-wider mb-1\">Weighted Pipeline</div>\n            <div className=\"text-2xl font-extrabold text-[#1a1c1c]\">{formatSummary(weightedPipeline)}</div>\n          </div>\n          <div className=\"w-10 h-10 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center\">\n            <span className=\"material-symbols-outlined\">donut_large</span>\n          </div>\n        </div>\n        <div className=\"bg-white p-5 rounded-2xl border border-[#E1E1E1] shadow-2xs flex items-center justify-between\">\n          <div>\n            <div className=\"text-[10px] font-extrabold text-[#767587] uppercase tracking-wider mb-1\">Won</div>\n            <div className=\"text-2xl font-extrabold text-emerald-600\">{formatSummary(totalWon)}</div>\n          </div>\n          <div className=\"w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center\">\n            <span className=\"material-symbols-outlined\">emoji_events</span>\n          </div>\n        </div>\n      </div>\n\n      {viewMode === \'PIPELINE\' ? (\n        /* Kanban Board */\n        <div className=\"flex-1 overflow-hidden flex flex-col\">\n          <div className=\"flex gap-4 overflow-x-auto overflow-y-hidden pb-4 h-full snap-x\">\n            {stages.map((stage) => {\n              const stageOpps = opportunities.filter(o => o.stage === stage.key);\n              const stageValue = stageOpps.reduce((acc, curr) => acc + curr.estimatedValue, 0);\n\n              return (\n                <div \n                  key={stage.key}\n                  className=\"flex-shrink-0 w-[300px] flex flex-col bg-slate-50/50 rounded-2xl border border-[#E1E1E1] overflow-hidden snap-center\"\n                  onDragOver={handleDragOver}\n                  onDrop={(e) => handleDrop(e, stage.key)}\n                >\n                  <div className={`p-4 bg-white border-b-2 ${stage.color}`}>\n                    <div className=\"flex items-center justify-between mb-2\">\n                      <h3 className=\"text-sm font-extrabold text-[#1a1c1c] uppercase tracking-wider\">\n                        {stage.label}\n                      </h3>\n                      <span className=\"px-2 py-0.5 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-full\">\n                        {stageOpps.length}\n                      </span>\n                    </div>\n                    <div className=\"text-xs font-bold text-slate-500\">\n                      {formatSummary(stageValue)}\n                    </div>\n                  </div>\n\n                  <div className=\"flex-1 overflow-y-auto p-3 space-y-3\">\n                    {stageOpps.map(opp => (\n                      <div\n                        key={opp.id}\n                        id={`opp-card-${opp.id}`}\n                        draggable\n                        onDragStart={(e) => handleDragStart(e, opp.id)}\n                        onDragEnd={(e) => handleDragEnd(e, opp.id)}\n                        className=\"bg-white p-4 rounded-xl border border-[#E1E1E1] shadow-sm hover:shadow-md hover:border-indigo-300 transition-all cursor-grab active:cursor-grabbing group\"\n                      >\n                        <div className=\"flex flex-col gap-3\">\n                          <div>\n                            <div className=\"text-[10px] font-bold text-indigo-600 uppercase tracking-wider mb-1 truncate\">\n                              {opp.customerName}\n                            </div>\n                            <h4 className=\"text-sm font-bold text-[#1a1c1c] leading-tight\">\n                              {opp.name}\n                            </h4>\n                          </div>\n                          \n                          <div className=\"text-sm font-extrabold text-[#008f53]\">\n                            {formatMoney(opp.estimatedValue)}\n                          </div>\n\n                          <div className=\"flex items-center justify-between pt-3 border-t border-slate-100\">\n                            <div className=\"flex items-center gap-2\">\n                              {opp.picAvatar ? (\n                                <img src={opp.picAvatar} alt={opp.picName} className=\"w-5 h-5 rounded-full object-cover border border-slate-200\" />\n                              ) : (\n                                <div className=\"w-5 h-5 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center text-[9px] font-bold border border-slate-300\">\n                                  {opp.picName.charAt(0)}\n                                </div>\n                              )}\n                              <span className=\"text-[11px] font-medium text-slate-600 truncate max-w-[80px]\">\n                                {opp.picName}\n                              </span>\n                            </div>\n                            <div className=\"flex items-center gap-1 text-slate-500\">\n                              <span className=\"material-symbols-outlined text-[12px]\">event</span>\n                              <span className=\"text-[10px] font-semibold\">\n                                {new Date(opp.expectedCloseDate).toLocaleDateString(\'en-GB\', { day: \'numeric\', month: \'short\' })}\n                              </span>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    ))}\n                    {stageOpps.length === 0 && (\n                      <div className=\"h-24 border-2 border-dashed border-slate-200 rounded-xl flex items-center justify-center text-slate-400 text-xs font-medium\">\n                        Drop here\n                      </div>\n                    )}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      ) : (\n        /* List View */\n        <div className=\"bg-white rounded-2xl border border-[#E1E1E1] shadow-2xs overflow-hidden flex flex-col\">\n          {/* List Toolbar */}\n          <div className=\"p-4 border-b border-[#E1E1E1] flex flex-col lg:flex-row gap-4 justify-between items-start lg:items-center bg-slate-50/50\">\n            <div className=\"flex flex-wrap items-center gap-3 w-full lg:w-auto\">\n              <div className=\"relative flex-1 sm:flex-none sm:min-w-[240px]\">\n                <span className=\"material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]\">search</span>\n                <input \n                  type=\"text\" \n                  placeholder=\"Search opportunities...\" \n                  value={searchTerm}\n                  onChange={(e) => setSearchTerm(e.target.value)}\n                  className=\"w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-shadow\"\n                />\n              </div>\n              <select \n                value={stageFilter}\n                onChange={(e) => setStageFilter(e.target.value)}\n                className=\"px-3 py-2 bg-white border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"ALL\">All Stages</option>\n                {stages.map(s => (\n                  <option key={s.key} value={s.key}>{s.label}</option>\n                ))}\n              </select>\n              <select \n                value={customerFilter}\n                onChange={(e) => setCustomerFilter(e.target.value)}\n                className=\"px-3 py-2 bg-white border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"ALL\">All Customers</option>\n                {customers.map(c => (\n                  <option key={c.id} value={c.id}>{c.name}</option>\n                ))}\n              </select>\n            </div>\n            \n            <div className=\"flex items-center gap-2\">\n              <button className=\"p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors\" title=\"Columns\">\n                <span className=\"material-symbols-outlined text-[20px]\">view_column</span>\n              </button>\n              <button className=\"p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors\" title=\"Sort\">\n                <span className=\"material-symbols-outlined text-[20px]\">sort</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Table */}\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse\">\n              <thead>\n                <tr className=\"bg-slate-50 border-b border-[#E1E1E1]\">\n                  <th className=\"px-5 py-3 w-10\">\n                    <input \n                      type=\"checkbox\" \n                      checked={paginatedList.length > 0 && selectedIds.size === paginatedList.length}\n                      onChange={toggleSelectAll}\n                      className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500\"\n                    />\n                  </th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider\">Opportunity</th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider\">Value</th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider\">Stage</th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider\">PIC</th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider\">Expected Close</th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider text-right\">Actions</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-[#E1E1E1]\">\n                {paginatedList.length === 0 ? (\n                  <tr>\n                    <td colSpan={7} className=\"px-5 py-8 text-center text-slate-500 text-sm\">\n                      No opportunities found.\n                    </td>\n                  </tr>\n                ) : (\n                  paginatedList.map((opp) => (\n                    <tr key={opp.id} className={`hover:bg-slate-50 transition-colors ${selectedIds.has(opp.id) ? \'bg-indigo-50/30\' : \'\'}`}>\n                      <td className=\"px-5 py-4\">\n                        <input \n                          type=\"checkbox\" \n                          checked={selectedIds.has(opp.id)}\n                          onChange={() => toggleSelect(opp.id)}\n                          className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500\"\n                        />\n                      </td>\n                      <td className=\"px-5 py-4\">\n                        <div className=\"font-bold text-[#1a1c1c] text-sm leading-tight\">{opp.name}</div>\n                        <div className=\"text-xs text-indigo-600 font-semibold mt-0.5\">{opp.customerName}</div>\n                      </td>\n                      <td className=\"px-5 py-4\">\n                        <div className=\"text-sm font-extrabold text-[#008f53]\">\n                          {formatMoney(opp.estimatedValue)}\n                        </div>\n                        <div className=\"text-[10px] text-slate-500 font-bold mt-0.5\">\n                          {opp.probability}% Prob.\n                        </div>\n                      </td>\n                      <td className=\"px-5 py-4\">\n                        {getStageBadge(opp.stage)}\n                      </td>\n                      <td className=\"px-5 py-4\">\n                        <div className=\"flex items-center gap-2\">\n                          {opp.picAvatar ? (\n                            <img src={opp.picAvatar} alt={opp.picName} className=\"w-6 h-6 rounded-full object-cover border border-slate-200\" />\n                          ) : (\n                            <div className=\"w-6 h-6 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center text-[10px] font-bold border border-slate-300\">\n                              {opp.picName.charAt(0)}\n                            </div>\n                          )}\n                          <span className=\"text-xs font-semibold text-slate-700\">{opp.picName}</span>\n                        </div>\n                      </td>\n                      <td className=\"px-5 py-4\">\n                        <div className=\"text-sm font-semibold text-[#1a1c1c]\">\n                          {new Date(opp.expectedCloseDate).toLocaleDateString(\'en-GB\', { day: \'numeric\', month: \'short\', year: \'numeric\' })}\n                        </div>\n                        <div className=\"text-[10px] text-slate-400 font-medium mt-0.5\">\n                          Updated {new Date(opp.updatedAt).toLocaleDateString()}\n                        </div>\n                      </td>\n                      <td className=\"px-5 py-4 text-right\">\n                        <div className=\"flex items-center justify-end gap-1\">\n                          <button className=\"p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors cursor-pointer\" title=\"Edit\">\n                            <span className=\"material-symbols-outlined text-[18px]\">edit</span>\n                          </button>\n                          <button className=\"p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors cursor-pointer\" title=\"More\">\n                            <span className=\"material-symbols-outlined text-[18px]\">more_vert</span>\n                          </button>\n                        </div>\n                      </td>\n                    </tr>\n                  ))\n                )}\n              </tbody>\n            </table>\n          </div>\n          \n          {/* Pagination */}\n          {totalPages > 0 && (\n            <div className=\"p-4 border-t border-[#E1E1E1] flex items-center justify-between bg-slate-50\">\n              <div className=\"text-xs text-slate-500 font-medium\">\n                Showing <span className=\"font-bold text-[#1a1c1c]\">{(currentPage - 1) * itemsPerPage + 1}</span> to <span className=\"font-bold text-[#1a1c1c]\">{Math.min(currentPage * itemsPerPage, filteredList.length)}</span> of <span className=\"font-bold text-[#1a1c1c]\">{filteredList.length}</span> opportunities\n              </div>\n              <div className=\"flex gap-1\">\n                <button \n                  onClick={() => setCurrentPage(prev => Math.max(prev - 1, 1))}\n                  disabled={currentPage === 1}\n                  className=\"p-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed\"\n                >\n                  <span className=\"material-symbols-outlined text-[18px]\">chevron_left</span>\n                </button>\n                <button \n                  onClick={() => setCurrentPage(prev => Math.min(prev + 1, totalPages))}\n                  disabled={currentPage === totalPages}\n                  className=\"p-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed\"\n                >\n                  <span className=\"material-symbols-outlined text-[18px]\">chevron_right</span>\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n};\nEOF"
    proposed_command_line: "cat << \'EOF\' > src/pages/opportunities/OpportunitiesPage.tsx\nimport React, { useState, useMemo, DragEvent } from \'react\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { DataService } from \'../../services/dataService\';\nimport { Opportunity, OpportunityStage, ActivityType, Customer } from \'../../types\';\n\ntype ViewMode = \'PIPELINE\' | \'LIST\';\n\nexport const OpportunitiesPage: React.FC = () => {\n  const { currentTenant, currentUser } = useAuth();\n  const tenantId = currentTenant?.id || \'TEN-00001\';\n\n  const [opportunities, setOpportunities] = useState<Opportunity[]>(DataService.getOpportunities(tenantId));\n  const [customers] = useState<Customer[]>(DataService.getCustomers(tenantId));\n  const [viewMode, setViewMode] = useState<ViewMode>(\'LIST\');\n  const [draggedOppId, setDraggedOppId] = useState<string | null>(null);\n\n  // Filters for List View\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [stageFilter, setStageFilter] = useState<string>(\'ALL\');\n  const [customerFilter, setCustomerFilter] = useState<string>(\'ALL\');\n  \n  // List View Pagination & Selection\n  const [currentPage, setCurrentPage] = useState(1);\n  const itemsPerPage = 10;\n  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());\n\n  const stages: { key: OpportunityStage; label: string; color: string }[] = [\n    { key: \'LEAD\', label: \'Prospect\', color: \'border-slate-300\' },\n    { key: \'QUALIFICATION\', label: \'Qualification\', color: \'border-blue-300\' },\n    { key: \'PROPOSAL\', label: \'Proposal\', color: \'border-indigo-300\' },\n    { key: \'NEGOTIATION\', label: \'Negotiation\', color: \'border-amber-300\' },\n    { key: \'WON\', label: \'Won\', color: \'border-emerald-300\' },\n    { key: \'LOST\', label: \'Lost\', color: \'border-rose-300\' },\n  ];\n\n  // Summaries\n  const totalPipeline = useMemo(() => opportunities.reduce((acc, curr) => acc + curr.estimatedValue, 0), [opportunities]);\n  const weightedPipeline = useMemo(() => opportunities.reduce((acc, curr) => acc + (curr.estimatedValue * (curr.probability / 100)), 0), [opportunities]);\n  const totalWon = useMemo(() => opportunities.filter(o => o.stage === \'WON\').reduce((acc, curr) => acc + curr.estimatedValue, 0), [opportunities]);\n\n  const formatMoney = (val: number) => {\n    return new Intl.NumberFormat(\'id-ID\', {\n      style: \'currency\',\n      currency: \'IDR\',\n      minimumFractionDigits: 0,\n      maximumFractionDigits: 0\n    }).format(val);\n  };\n\n  const formatSummary = (val: number) => {\n    if (val >= 1000000000) return `Rp ${(val / 1000000000).toFixed(1)}B`;\n    if (val >= 1000000) return `Rp ${(val / 1000000).toFixed(1)}M`;\n    return formatMoney(val);\n  };\n\n  const handleDragStart = (e: DragEvent<HTMLDivElement>, oppId: string) => {\n    setDraggedOppId(oppId);\n    e.dataTransfer.effectAllowed = \'move\';\n    e.dataTransfer.setData(\'text/plain\', oppId);\n    setTimeout(() => {\n      const el = document.getElementById(`opp-card-${oppId}`);\n      if (el) el.classList.add(\'opacity-50\');\n    }, 0);\n  };\n\n  const handleDragEnd = (e: DragEvent<HTMLDivElement>, oppId: string) => {\n    setDraggedOppId(null);\n    const el = document.getElementById(`opp-card-${oppId}`);\n    if (el) el.classList.remove(\'opacity-50\');\n  };\n\n  const handleDragOver = (e: DragEvent<HTMLDivElement>) => {\n    e.preventDefault();\n    e.dataTransfer.dropEffect = \'move\';\n  };\n\n  const handleDrop = (e: DragEvent<HTMLDivElement>, targetStage: OpportunityStage) => {\n    e.preventDefault();\n    const oppId = e.dataTransfer.getData(\'text/plain\');\n    if (!oppId) return;\n\n    const opp = opportunities.find(o => o.id === oppId);\n    if (!opp || opp.stage === targetStage) return;\n\n    const oldStageLabel = stages.find(s => s.key === opp.stage)?.label || opp.stage;\n    const newStageLabel = stages.find(s => s.key === targetStage)?.label || targetStage;\n\n    const updatedOpp = { ...opp, stage: targetStage, updatedAt: new Date().toISOString() };\n    DataService.saveOpportunity(updatedOpp);\n    \n    const activity = {\n      tenantId: opp.tenantId,\n      customerId: opp.customerId,\n      customerName: opp.customerName,\n      userId: currentUser?.id || \'SYS-001\',\n      userName: currentUser?.name || \'System\',\n      type: \'OPPORTUNITY\' as ActivityType,\n      subject: `Opportunity Stage Updated: ${targetStage}`,\n      description: `Opportunity \"${opp.name}\" was moved from ${oldStageLabel} to ${newStageLabel}.`,\n      occurredAt: new Date().toISOString(),\n      entityType: \'OPPORTUNITY\',\n      entityId: opp.id\n    };\n    DataService.addActivity(activity);\n\n    setOpportunities(DataService.getOpportunities(tenantId));\n  };\n\n  // List View Filtering\n  const filteredList = useMemo(() => {\n    return opportunities.filter(opp => {\n      if (searchTerm) {\n        const term = searchTerm.toLowerCase();\n        if (!opp.name.toLowerCase().includes(term) && !opp.customerName.toLowerCase().includes(term)) {\n          return false;\n        }\n      }\n      if (stageFilter !== \'ALL\' && opp.stage !== stageFilter) return false;\n      if (customerFilter !== \'ALL\' && opp.customerId !== customerFilter) return false;\n      return true;\n    });\n  }, [opportunities, searchTerm, stageFilter, customerFilter]);\n\n  const totalPages = Math.ceil(filteredList.length / itemsPerPage);\n  const paginatedList = filteredList.slice((currentPage - 1) * itemsPerPage, currentPage * itemsPerPage);\n\n  const toggleSelectAll = () => {\n    if (selectedIds.size === paginatedList.length) {\n      setSelectedIds(new Set());\n    } else {\n      setSelectedIds(new Set(paginatedList.map(o => o.id)));\n    }\n  };\n\n  const toggleSelect = (id: string) => {\n    const newSet = new Set(selectedIds);\n    if (newSet.has(id)) newSet.delete(id);\n    else newSet.add(id);\n    setSelectedIds(newSet);\n  };\n\n  const getStageBadge = (stage: OpportunityStage) => {\n    switch (stage) {\n      case \'LEAD\': return <span className=\"px-2 py-0.5 bg-slate-100 text-slate-700 text-[10px] font-bold rounded uppercase tracking-wider\">Prospect</span>;\n      case \'QUALIFICATION\': return <span className=\"px-2 py-0.5 bg-blue-100 text-blue-700 text-[10px] font-bold rounded uppercase tracking-wider\">Qualification</span>;\n      case \'PROPOSAL\': return <span className=\"px-2 py-0.5 bg-indigo-100 text-indigo-700 text-[10px] font-bold rounded uppercase tracking-wider\">Proposal</span>;\n      case \'NEGOTIATION\': return <span className=\"px-2 py-0.5 bg-amber-100 text-amber-700 text-[10px] font-bold rounded uppercase tracking-wider\">Negotiation</span>;\n      case \'WON\': return <span className=\"px-2 py-0.5 bg-emerald-100 text-emerald-700 text-[10px] font-bold rounded uppercase tracking-wider\">Won</span>;\n      case \'LOST\': return <span className=\"px-2 py-0.5 bg-rose-100 text-rose-700 text-[10px] font-bold rounded uppercase tracking-wider\">Lost</span>;\n      default: return null;\n    }\n  };\n\n  return (\n    <div className={`space-y-6 font-[\'Inter\',sans-serif] flex flex-col ${viewMode === \'PIPELINE\' ? \'h-[calc(100vh-80px)] min-h-[600px]\' : \'\'}`}>\n      \n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 shrink-0\">\n        <div>\n          <h1 className=\"text-2xl font-extrabold text-[#1a1c1c] font-[\'Hanken_Grotesk\'] tracking-tight\">\n            Opportunities\n          </h1>\n          <p className=\"text-xs text-[#767587] mt-0.5\">\n            Manage your opportunities and track revenue across the sales process.\n          </p>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <div className=\"bg-slate-100 p-1 rounded-xl flex items-center border border-slate-200\">\n            <button \n              onClick={() => setViewMode(\'LIST\')}\n              className={`px-3 py-1.5 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 ${viewMode === \'LIST\' ? \'bg-white text-[#1a1c1c] shadow-sm\' : \'text-slate-500 hover:text-[#1a1c1c]\'}`}\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">list</span>\n              List\n            </button>\n            <button \n              onClick={() => setViewMode(\'PIPELINE\')}\n              className={`px-3 py-1.5 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 ${viewMode === \'PIPELINE\' ? \'bg-white text-[#1a1c1c] shadow-sm\' : \'text-slate-500 hover:text-[#1a1c1c]\'}`}\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">view_kanban</span>\n              Pipeline\n            </button>\n          </div>\n          <button className=\"px-4 py-2 bg-white border border-[#E1E1E1] text-[#464555] hover:bg-slate-50 text-xs font-extrabold rounded-xl shadow-2xs transition-colors flex items-center gap-1.5 cursor-pointer\">\n            <span className=\"material-symbols-outlined text-[18px]\">download</span>\n            Export\n          </button>\n          <button className=\"px-4 py-2 bg-[#4744e5] hover:bg-[#322fce] text-white text-xs font-extrabold rounded-xl shadow-xs transition-colors flex items-center gap-1.5 cursor-pointer\">\n            <span className=\"material-symbols-outlined text-[18px]\">add</span>\n            New Opportunity\n          </button>\n        </div>\n      </div>\n\n      {/* Summary Row */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 shrink-0\">\n        <div className=\"bg-white p-5 rounded-2xl border border-[#E1E1E1] shadow-2xs flex items-center justify-between\">\n          <div>\n            <div className=\"text-[10px] font-extrabold text-[#767587] uppercase tracking-wider mb-1\">Total Pipeline</div>\n            <div className=\"text-2xl font-extrabold text-[#1a1c1c]\">{formatSummary(totalPipeline)}</div>\n          </div>\n          <div className=\"w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center\">\n            <span className=\"material-symbols-outlined\">monitoring</span>\n          </div>\n        </div>\n        <div className=\"bg-white p-5 rounded-2xl border border-[#E1E1E1] shadow-2xs flex items-center justify-between\">\n          <div>\n            <div className=\"text-[10px] font-extrabold text-[#767587] uppercase tracking-wider mb-1\">Weighted Pipeline</div>\n            <div className=\"text-2xl font-extrabold text-[#1a1c1c]\">{formatSummary(weightedPipeline)}</div>\n          </div>\n          <div className=\"w-10 h-10 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center\">\n            <span className=\"material-symbols-outlined\">donut_large</span>\n          </div>\n        </div>\n        <div className=\"bg-white p-5 rounded-2xl border border-[#E1E1E1] shadow-2xs flex items-center justify-between\">\n          <div>\n            <div className=\"text-[10px] font-extrabold text-[#767587] uppercase tracking-wider mb-1\">Won</div>\n            <div className=\"text-2xl font-extrabold text-emerald-600\">{formatSummary(totalWon)}</div>\n          </div>\n          <div className=\"w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center\">\n            <span className=\"material-symbols-outlined\">emoji_events</span>\n          </div>\n        </div>\n      </div>\n\n      {viewMode === \'PIPELINE\' ? (\n        /* Kanban Board */\n        <div className=\"flex-1 overflow-hidden flex flex-col\">\n          <div className=\"flex gap-4 overflow-x-auto overflow-y-hidden pb-4 h-full snap-x\">\n            {stages.map((stage) => {\n              const stageOpps = opportunities.filter(o => o.stage === stage.key);\n              const stageValue = stageOpps.reduce((acc, curr) => acc + curr.estimatedValue, 0);\n\n              return (\n                <div \n                  key={stage.key}\n                  className=\"flex-shrink-0 w-[300px] flex flex-col bg-slate-50/50 rounded-2xl border border-[#E1E1E1] overflow-hidden snap-center\"\n                  onDragOver={handleDragOver}\n                  onDrop={(e) => handleDrop(e, stage.key)}\n                >\n                  <div className={`p-4 bg-white border-b-2 ${stage.color}`}>\n                    <div className=\"flex items-center justify-between mb-2\">\n                      <h3 className=\"text-sm font-extrabold text-[#1a1c1c] uppercase tracking-wider\">\n                        {stage.label}\n                      </h3>\n                      <span className=\"px-2 py-0.5 bg-slate-100 text-slate-600 text-[10px] font-bold rounded-full\">\n                        {stageOpps.length}\n                      </span>\n                    </div>\n                    <div className=\"text-xs font-bold text-slate-500\">\n                      {formatSummary(stageValue)}\n                    </div>\n                  </div>\n\n                  <div className=\"flex-1 overflow-y-auto p-3 space-y-3\">\n                    {stageOpps.map(opp => (\n                      <div\n                        key={opp.id}\n                        id={`opp-card-${opp.id}`}\n                        draggable\n                        onDragStart={(e) => handleDragStart(e, opp.id)}\n                        onDragEnd={(e) => handleDragEnd(e, opp.id)}\n                        className=\"bg-white p-4 rounded-xl border border-[#E1E1E1] shadow-sm hover:shadow-md hover:border-indigo-300 transition-all cursor-grab active:cursor-grabbing group\"\n                      >\n                        <div className=\"flex flex-col gap-3\">\n                          <div>\n                            <div className=\"text-[10px] font-bold text-indigo-600 uppercase tracking-wider mb-1 truncate\">\n                              {opp.customerName}\n                            </div>\n                            <h4 className=\"text-sm font-bold text-[#1a1c1c] leading-tight\">\n                              {opp.name}\n                            </h4>\n                          </div>\n                          \n                          <div className=\"text-sm font-extrabold text-[#008f53]\">\n                            {formatMoney(opp.estimatedValue)}\n                          </div>\n\n                          <div className=\"flex items-center justify-between pt-3 border-t border-slate-100\">\n                            <div className=\"flex items-center gap-2\">\n                              {opp.picAvatar ? (\n                                <img src={opp.picAvatar} alt={opp.picName} className=\"w-5 h-5 rounded-full object-cover border border-slate-200\" />\n                              ) : (\n                                <div className=\"w-5 h-5 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center text-[9px] font-bold border border-slate-300\">\n                                  {opp.picName.charAt(0)}\n                                </div>\n                              )}\n                              <span className=\"text-[11px] font-medium text-slate-600 truncate max-w-[80px]\">\n                                {opp.picName}\n                              </span>\n                            </div>\n                            <div className=\"flex items-center gap-1 text-slate-500\">\n                              <span className=\"material-symbols-outlined text-[12px]\">event</span>\n                              <span className=\"text-[10px] font-semibold\">\n                                {new Date(opp.expectedCloseDate).toLocaleDateString(\'en-GB\', { day: \'numeric\', month: \'short\' })}\n                              </span>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    ))}\n                    {stageOpps.length === 0 && (\n                      <div className=\"h-24 border-2 border-dashed border-slate-200 rounded-xl flex items-center justify-center text-slate-400 text-xs font-medium\">\n                        Drop here\n                      </div>\n                    )}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      ) : (\n        /* List View */\n        <div className=\"bg-white rounded-2xl border border-[#E1E1E1] shadow-2xs overflow-hidden flex flex-col\">\n          {/* List Toolbar */}\n          <div className=\"p-4 border-b border-[#E1E1E1] flex flex-col lg:flex-row gap-4 justify-between items-start lg:items-center bg-slate-50/50\">\n            <div className=\"flex flex-wrap items-center gap-3 w-full lg:w-auto\">\n              <div className=\"relative flex-1 sm:flex-none sm:min-w-[240px]\">\n                <span className=\"material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]\">search</span>\n                <input \n                  type=\"text\" \n                  placeholder=\"Search opportunities...\" \n                  value={searchTerm}\n                  onChange={(e) => setSearchTerm(e.target.value)}\n                  className=\"w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-shadow\"\n                />\n              </div>\n              <select \n                value={stageFilter}\n                onChange={(e) => setStageFilter(e.target.value)}\n                className=\"px-3 py-2 bg-white border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"ALL\">All Stages</option>\n                {stages.map(s => (\n                  <option key={s.key} value={s.key}>{s.label}</option>\n                ))}\n              </select>\n              <select \n                value={customerFilter}\n                onChange={(e) => setCustomerFilter(e.target.value)}\n                className=\"px-3 py-2 bg-white border border-slate-200 rounded-xl text-sm text-slate-700 focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"ALL\">All Customers</option>\n                {customers.map(c => (\n                  <option key={c.id} value={c.id}>{c.name}</option>\n                ))}\n              </select>\n            </div>\n            \n            <div className=\"flex items-center gap-2\">\n              <button className=\"p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors\" title=\"Columns\">\n                <span className=\"material-symbols-outlined text-[20px]\">view_column</span>\n              </button>\n              <button className=\"p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors\" title=\"Sort\">\n                <span className=\"material-symbols-outlined text-[20px]\">sort</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Table */}\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse\">\n              <thead>\n                <tr className=\"bg-slate-50 border-b border-[#E1E1E1]\">\n                  <th className=\"px-5 py-3 w-10\">\n                    <input \n                      type=\"checkbox\" \n                      checked={paginatedList.length > 0 && selectedIds.size === paginatedList.length}\n                      onChange={toggleSelectAll}\n                      className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500\"\n                    />\n                  </th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider\">Opportunity</th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider\">Value</th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider\">Stage</th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider\">PIC</th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider\">Expected Close</th>\n                  <th className=\"px-5 py-3 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider text-right\">Actions</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-[#E1E1E1]\">\n                {paginatedList.length === 0 ? (\n                  <tr>\n                    <td colSpan={7} className=\"px-5 py-8 text-center text-slate-500 text-sm\">\n                      No opportunities found.\n                    </td>\n                  </tr>\n                ) : (\n                  paginatedList.map((opp) => (\n                    <tr key={opp.id} className={`hover:bg-slate-50 transition-colors ${selectedIds.has(opp.id) ? \'bg-indigo-50/30\' : \'\'}`}>\n                      <td className=\"px-5 py-4\">\n                        <input \n                          type=\"checkbox\" \n                          checked={selectedIds.has(opp.id)}\n                          onChange={() => toggleSelect(opp.id)}\n                          className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500\"\n                        />\n                      </td>\n                      <td className=\"px-5 py-4\">\n                        <div className=\"font-bold text-[#1a1c1c] text-sm leading-tight\">{opp.name}</div>\n                        <div className=\"text-xs text-indigo-600 font-semibold mt-0.5\">{opp.customerName}</div>\n                      </td>\n                      <td className=\"px-5 py-4\">\n                        <div className=\"text-sm font-extrabold text-[#008f53]\">\n                          {formatMoney(opp.estimatedValue)}\n                        </div>\n                        <div className=\"text-[10px] text-slate-500 font-bold mt-0.5\">\n                          {opp.probability}% Prob.\n                        </div>\n                      </td>\n                      <td className=\"px-5 py-4\">\n                        {getStageBadge(opp.stage)}\n                      </td>\n                      <td className=\"px-5 py-4\">\n                        <div className=\"flex items-center gap-2\">\n                          {opp.picAvatar ? (\n                            <img src={opp.picAvatar} alt={opp.picName} className=\"w-6 h-6 rounded-full object-cover border border-slate-200\" />\n                          ) : (\n                            <div className=\"w-6 h-6 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center text-[10px] font-bold border border-slate-300\">\n                              {opp.picName.charAt(0)}\n                            </div>\n                          )}\n                          <span className=\"text-xs font-semibold text-slate-700\">{opp.picName}</span>\n                        </div>\n                      </td>\n                      <td className=\"px-5 py-4\">\n                        <div className=\"text-sm font-semibold text-[#1a1c1c]\">\n                          {new Date(opp.expectedCloseDate).toLocaleDateString(\'en-GB\', { day: \'numeric\', month: \'short\', year: \'numeric\' })}\n                        </div>\n                        <div className=\"text-[10px] text-slate-400 font-medium mt-0.5\">\n                          Updated {new Date(opp.updatedAt).toLocaleDateString()}\n                        </div>\n                      </td>\n                      <td className=\"px-5 py-4 text-right\">\n                        <div className=\"flex items-center justify-end gap-1\">\n                          <button className=\"p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors cursor-pointer\" title=\"Edit\">\n                            <span className=\"material-symbols-outlined text-[18px]\">edit</span>\n                          </button>\n                          <button className=\"p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors cursor-pointer\" title=\"More\">\n                            <span className=\"material-symbols-outlined text-[18px]\">more_vert</span>\n                          </button>\n                        </div>\n                      </td>\n                    </tr>\n                  ))\n                )}\n              </tbody>\n            </table>\n          </div>\n          \n          {/* Pagination */}\n          {totalPages > 0 && (\n            <div className=\"p-4 border-t border-[#E1E1E1] flex items-center justify-between bg-slate-50\">\n              <div className=\"text-xs text-slate-500 font-medium\">\n                Showing <span className=\"font-bold text-[#1a1c1c]\">{(currentPage - 1) * itemsPerPage + 1}</span> to <span className=\"font-bold text-[#1a1c1c]\">{Math.min(currentPage * itemsPerPage, filteredList.length)}</span> of <span className=\"font-bold text-[#1a1c1c]\">{filteredList.length}</span> opportunities\n              </div>\n              <div className=\"flex gap-1\">\n                <button \n                  onClick={() => setCurrentPage(prev => Math.max(prev - 1, 1))}\n                  disabled={currentPage === 1}\n                  className=\"p-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed\"\n                >\n                  <span className=\"material-symbols-outlined text-[18px]\">chevron_left</span>\n                </button>\n                <button \n                  onClick={() => setCurrentPage(prev => Math.min(prev + 1, totalPages))}\n                  disabled={currentPage === totalPages}\n                  className=\"p-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed\"\n                >\n                  <span className=\"material-symbols-outlined text-[18px]\">chevron_right</span>\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n};\nEOF"
    shell_name: "bash"
  }
}
