        target_content: "import React, { useState, useMemo, DragEvent } from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { DataService } from \'../../services/dataService\';\nimport { Opportunity, OpportunityStage, ActivityType, Customer } from \'../../types\';\n\ntype ViewMode = \'PIPELINE\' | \'LIST\';\n\nexport const OpportunitiesPage: React.FC = () => {\n  const navigate = useNavigate();\n  const { currentTenant, currentUser } = useAuth();\n  const tenantId = currentTenant?.id || \'TEN-00001\';\n\n  const [opportunities, setOpportunities] = useState<Opportunity[]>(DataService.getOpportunities(tenantId));\n  const [customers] = useState<Customer[]>(DataService.getCustomers(tenantId));\n  const [viewMode, setViewMode] = useState<ViewMode>(\'LIST\');\n  const [draggedOppId, setDraggedOppId] = useState<string | null>(null);"
        replacement_content: "import React, { useState, useMemo, DragEvent } from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { DataService } from \'../../services/dataService\';\nimport { Opportunity, OpportunityStage, ActivityType, Customer, FollowUpType } from \'../../types\';\n\ntype ViewMode = \'PIPELINE\' | \'LIST\';\n\nexport const OpportunitiesPage: React.FC = () => {\n  const navigate = useNavigate();\n  const { currentTenant, currentUser } = useAuth();\n  const tenantId = currentTenant?.id || \'TEN-00001\';\n\n  const [opportunities, setOpportunities] = useState<Opportunity[]>(DataService.getOpportunities(tenantId));\n  const [customers] = useState<Customer[]>(DataService.getCustomers(tenantId));\n  const [viewMode, setViewMode] = useState<ViewMode>(\'LIST\');\n  const [draggedOppId, setDraggedOppId] = useState<string | null>(null);\n\n  // Follow Up Modal State\n  const [showFollowUpModal, setShowFollowUpModal] = useState(false);\n  const [pendingFollowUpOpp, setPendingFollowUpOpp] = useState<Opportunity | null>(null);\n  const [followUpTitle, setFollowUpTitle] = useState(\'\');\n  const [followUpType, setFollowUpType] = useState<FollowUpType>(\'CALL\');\n  const [followUpDate, setFollowUpDate] = useState(new Date().toISOString().split(\'T\')[0]);\n  const [followUpNotes, setFollowUpNotes] = useState(\'\');"
      }
