        target_content: "    setDraggedTaskId(null);\n  };\n\n  const handleCreateFollowUp = () => {\n    if (!pendingFollowUpTask) return;\n\n    const oldStatus = pendingFollowUpTask.status;\n    const updatedTask = { ...pendingFollowUpTask, status: \'FOLLOW_UP\' as TaskStatus };\n    \n    // Update locally\n    const updatedTasks = tasks.map(t => t.id === updatedTask.id ? updatedTask : t);\n    setTasks(updatedTasks);\n    \n    // Save to DataService\n    DataService.saveTask(updatedTask);\n    \n    // Create FollowUp entity\n    DataService.saveFollowUp({\n      id: `FU-${Date.now()}`,\n      tenantId,\n      title: followUpTitle,\n      customerId: pendingFollowUpTask.customerId || \'\',\n      customerName: pendingFollowUpTask.customerName || \'\',\n      customerCode: pendingFollowUpTask.customerCode || \'\',\n      picId: pendingFollowUpTask.picId,\n      picName: pendingFollowUpTask.picName,\n      picAvatar: pendingFollowUpTask.picAvatar,\n      type: followUpType,\n      status: \'SCHEDULED\',\n      followUpDate: followUpDate,\n      notes: followUpNotes,\n      relatedTaskId: pendingFollowUpTask.id,\n      createdAt: new Date().toISOString()\n    });\n    \n    // Add Activity\n    DataService.addActivity({\n      tenantId,\n      customerId: updatedTask.customerId,\n      customerName: updatedTask.customerName,\n      userId: currentUser?.id || \'SYSTEM\',\n      userName: currentUser?.name || \'System User\',\n      type: \'TASK\',\n      subject: \'Task Status Updated to Follow Up\',\n      description: `Moved task \"${updatedTask.title}\" to FOLLOW UPS and created a ${followUpType} follow-up.`,\n      occurredAt: new Date().toISOString(),\n      entityType: \'TASK\',\n      entityId: updatedTask.id\n    });\n\n    setShowFollowUpModal(false);\n    setPendingFollowUpTask(null);\n  };\n\n  const handleAddTask = (status: TaskStatus) => {"
