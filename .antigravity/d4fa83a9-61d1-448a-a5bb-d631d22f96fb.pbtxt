    generator_model: MODEL_GOOGLE_GEMINI_INTERNAL_BYOM
    execution_id: "d4fa83a9-61d1-448a-a5bb-d631d22f96fb"
    source_trajectory_step_info {
      trajectory_id: "d4fa83a9-61d1-448a-a5bb-d631d22f96fb"
      step_index: 93
      metadata_index: 267
