        target_content: "  const handleDrop = (e: React.DragEvent, newStatus: TaskStatus) => {\n    e.preventDefault();\n    const taskId = e.dataTransfer.getData(\'text/plain\');\n    if (!taskId) return;\n\n    const taskToMove = tasks.find(t => t.id === taskId);\n    if (taskToMove && taskToMove.status !== newStatus) {\n      if (newStatus === \'FOLLOW_UP\') {\n        setPendingFollowUpTask(taskToMove);\n        setFollowUpTitle(`Follow up: ${taskToMove.title}`);\n        setFollowUpType(\'CALL\');\n        setFollowUpDate(new Date().toISOString().split(\'T\')[0]);\n        setFollowUpNotes(\'\');\n        setShowFollowUpModal(true);\n        setDraggedTaskId(null);\n        return;\n      }\n\n      const oldStatus = taskToMove.status;\n      const updatedTask = { ...taskToMove, status: newStatus };"
        replacement_content: "  const handleDrop = (e: React.DragEvent, newStatus: TaskStatus) => {\n    e.preventDefault();\n    const taskId = e.dataTransfer.getData(\'text/plain\');\n    if (!taskId) return;\n\n    const taskToMove = tasks.find(t => t.id === taskId);\n    if (taskToMove && taskToMove.status !== newStatus) {\n      const oldStatus = taskToMove.status;\n      const updatedTask = { ...taskToMove, status: newStatus };"
