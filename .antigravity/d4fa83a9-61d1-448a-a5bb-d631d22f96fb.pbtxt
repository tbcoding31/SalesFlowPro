          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const isCurrent = idx === currentStageIndex;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
