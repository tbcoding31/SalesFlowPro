    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useMemo, useRef, useEffect } from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { DataService } from \'../../services/dataService\';\nimport { User, Customer, Visit, Opportunity, TaskPriority } from \'../../types\';\n\nexport const EditTaskPage: React.FC = () => {\n  const navigate = useNavigate();\n  const { currentTenant, currentUser } = useAuth();\n  const tenantId = currentTenant?.id || \'TEN-00001\';\n\n  const [title, setTitle] = useState(\'\');\n  const [description, setDescription] = useState(\'\');\n  const [customerId, setCustomerId] = useState(\'\');\n  const [relatedVisitId, setRelatedVisitId] = useState(\'\');\n  const [relatedOpportunityId, setRelatedOpportunityId] = useState(\'\');\n  \n  const [picId, setPicId] = useState<string>(\'\');\n  const [dueDate, setDueDate] = useState(\'\');\n  const [priority, setPriority] = useState<TaskPriority>(\'MEDIUM\');\n\n  const [customers] = useState<Customer[]>(DataService.getCustomers(tenantId));"
        replacement_content: "import React, { useState, useMemo, useRef, useEffect } from \'react\';\nimport { useNavigate, useParams } from \'react-router-dom\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { DataService } from \'../../services/dataService\';\nimport { User, Customer, Visit, Opportunity, TaskPriority, TaskStatus, Task } from \'../../types\';\n\nexport const EditTaskPage: React.FC = () => {\n  const navigate = useNavigate();\n  const { id } = useParams<{ id: string }>();\n  const { currentTenant, currentUser } = useAuth();\n  const tenantId = currentTenant?.id || \'TEN-00001\';\n\n  const [task, setTask] = useState<Task | null>(null);\n\n  const [title, setTitle] = useState(\'\');\n  const [description, setDescription] = useState(\'\');\n  const [customerId, setCustomerId] = useState(\'\');\n  const [relatedVisitId, setRelatedVisitId] = useState(\'\');\n  const [relatedOpportunityId, setRelatedOpportunityId] = useState(\'\');\n  \n  const [picId, setPicId] = useState<string>(\'\');\n  const [dueDate, setDueDate] = useState(\'\');\n  const [priority, setPriority] = useState<TaskPriority>(\'MEDIUM\');\n  const [status, setStatus] = useState<TaskStatus>(\'TODO\');\n\n  const [customers] = useState<Customer[]>(DataService.getCustomers(tenantId));"
      }
