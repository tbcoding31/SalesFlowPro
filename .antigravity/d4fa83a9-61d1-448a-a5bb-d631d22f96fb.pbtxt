          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            t.status === \'COMPLETED\' ? \'bg-emerald-50 text-emerald-700 border-emerald-200\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            : t.status === \'REVIEW\' ? \'bg-purple-50 text-purple-700 border-purple-200\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            : t.status === \'IN_PROGRESS\' ? \'bg-blue-50 text-blue-700 border-blue-200\'"
