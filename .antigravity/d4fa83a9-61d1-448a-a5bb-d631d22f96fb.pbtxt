      markdown: "Task id \"d4fa83a9-61d1-448a-a5bb-d631d22f96fb/task-183\" finished with result:\nCommand output:\n<truncated 21 bytes>\nseAuth } from \'../../context/AuthContext\';import { DataService } from \'../../services/dataService\';import { User, SalesTarget } from \'../../types\';export const PerformancePage: React.FC = () => {  const { currentTenant } = useAuth();  const tenantId = currentTenant?.id || \'TEN-00001\';  const [period, setPeriod] = useState<string>(\'Q3 2026\');  const [users] = useState<User[]>(DataService.getUsers(tenantId));  const [targets] = useState<SalesTarget[]>(DataService.getTargets(tenantId));  // Generate leaderboard data  const leaderboard = users    .filter((u) => u.role === \'SALES_REPRESENTATIVE\' || u.role === \'SUPERVISOR\')    .map((usr) => {      const trg = targets.find((t) => t.repId === usr.id || t.userId === usr.id) || {        targetRevenue: 10000000000,        achievedRevenue: 8500000000,        targetVisits: 40,        achievedVisits: 32,      };      const targetRev = trg.targetRevenue || trg.targetAmount || 1;      const achievedRev = trg.achievedRevenue || trg.actualAmount || 0;      const visitsDone = trg.achievedVisits || trg.actualVisits || 30;      const achievementRate = Math.round((achievedRev / targetRev) * 100);      const commission = achievedRev * 0.025; // 2.5% commission      return {        id: usr.id,        name: usr.name,        email: usr.email,        avatarUrl: usr.avatarUrl,        position: usr.position,        department: usr.department,        visitsConducted: visitsDone,        tasksCompleted: Math.floor(visitsDone * 1.5),        dealsWonValue: achievedRev,        quotaRate: achievementRate,        commissionEarned: commission,      };    })    .sort((a, b) => b.dealsWonValue - a.dealsWonValue);  return (    <div className=\"space-y-6 font-[\'Inter\',sans-serif]\">      {/* Header */}      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-xl border border-[#E1E1E1] shadow-sm\">        <div>          <div className=\"flex items-center gap-2\">            <span className=\"px-2.5 py-0.5 bg-[#4744e5]/10 text-[#4744e5] text-xs font-bold rounded uppercase\">              Sales Analytics            </span>          </div>          <h1 className=\"text-2xl font-bold text-[#1a1c1c] font-[\'Hanken_Grotesk\'] mt-1\">            Sales Performance & Leaderboard          </h1>          <p className=\"text-xs text-[#464555] mt-0.5\">            Rank sales team members by revenue closed, visit frequencies, and quota attainment.          </p>        </div>        <select          value={period}          onChange={(e) => setPeriod(e.target.value)}          className=\"bg-white border border-[#E1E1E1] text-[#1a1c1c] text-xs font-bold rounded-lg px-3 py-2 focus:outline-none\"        >          <option value=\"Q1 2026\">Q1 2026</option>          <option value=\"Q2 2026\">Q2 2026</option>          <option value=\"Q3 2026\">Q3 2026</option>          <option value=\"Q4 2026\">Q4 2026</option>        </select>      </div>      {/* Top Performers Podium / KPI Summary */}      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">        {leaderboard.slice(0, 3).map((item, idx) => (          <div            key={item.id}            className={`p-5 rounded-xl border bg-white shadow-sm flex flex-col justify-between space-y-3 relative overflow-hidden ${              idx === 0                ? \'border-[#4744e5] ring-2 ring-[#4744e5]/10\'                : \'border-[#E1E1E1]\'            }`}          >            <div className=\"flex justify-between items-start\">              <div className=\"flex items-center gap-3\">                <div                  className={`w-8 h-8 rounded-full font-bold text-xs flex items-center justify-center font-[\'Hanken_Grotesk\'] ${                    idx === 0                      ? \'bg-[#4744e5] text-white\'                      : idx === 1                      ? \'bg-[#6161ff] text-white\'                      : \'bg-[#767587] text-white\'                  }`}                >                  #{idx + 1}                </div>                <div>                  <h3 className=\"font-bold text-sm text-[#1a1c1c] font-[\'Hanken_Grotesk\']\">                    {item.name}                  </h3>                  <p className=\"text-[11px] text-[#767587]\">{item.position}</p>                </div>              </div>              <span className=\"px-2 py-0.5 bg-[#00C875]/10 text-[#008f53] text-[10px] font-bold rounded-full\">                {item.quotaRate}% Quota              </span>            </div>            <div>              <span className=\"text-[10px] text-[#767587] uppercase font-bold tracking-wider\">                Deals Won Revenue              </span>              <div className=\"text-xl font-extrabold text-[#1a1c1c] font-[\'Hanken_Grotesk\']\">                Rp {(item.dealsWonValue / 1000000000).toFixed(2)}B IDR              </div>            </div>            <div className=\"flex justify-between text-[11px] border-t border-[#E1E1E1] pt-2 text-[#464555]\">              <span>Visits: {item.visitsConducted}</span>              <span>Commission: Rp {(item.commissionEarned / 1000000).toFixed(0)}M</span>            </div>          </div>        ))}      </div>      {/* Leaderboard Table */}      <div className=\"bg-white rounded-xl border border-[#E1E1E1] shadow-sm overflow-hidden p-6 space-y-4\">        <h2 className=\"text-base font-bold text-[#1a1c1c] font-[\'Hanken_Grotesk\'] border-b border-[#E1E1E1] pb-3\">          Full Sales Force Performance Leaderboard        </h2>        <div className=\"overflow-x-auto\">          <table className=\"w-full text-left text-xs text-[#1a1c1c]\">            <thead className=\"bg-[#f9f9f9] text-[#464555] font-bold uppercase border-b border-[#E1E1E1]\">              <tr>                <th className=\"px-6 py-3.5 w-12 text-center\">Rank</th>                <th className=\"px-6 py-3.5\">S