    replacement_chunks {
      target_content: "  const handleDrop = (e: DragEvent<HTMLDivElement>, targetStage: OpportunityStage) => {\n    e.preventDefault();\n    const oppId = e.dataTransfer.getData(\'text/plain\');\n    if (!oppId) return;\n\n    const opp = opportunities.find(o => o.id === oppId);\n    if (!opp || opp.stage === targetStage) return;\n\n    const oldStageLabel = stages.find(s => s.key === opp.stage)?.label || opp.stage;\n    const newStageLabel = stages.find(s => s.key === targetStage)?.label || targetStage;\n\n    const updatedOpp = { ...opp, stage: targetStage, updatedAt: new Date().toISOString() };\n    DataService.saveOpportunity(updatedOpp);\n    \n    const activity = {\n      tenantId: opp.tenantId,\n      customerId: opp.customerId,\n      customerName: opp.customerName,\n      userId: currentUser?.id || \'SYS-001\',\n      userName: currentUser?.name || \'System\',\n      type: \'OPPORTUNITY\' as ActivityType,\n      subject: `Opportunity Stage Updated: ${targetStage}`,\n      description: `Opportunity \"${opp.name}\" was moved from ${oldStageLabel} to ${newStageLabel}.`,\n      occurredAt: new Date().toISOString(),\n      entityType: \'OPPORTUNITY\',\n      entityId: opp.id\n    };\n    DataService.addActivity(activity);\n\n    setOpportunities(DataService.getOpportunities(tenantId));\n  };"
      replacement_content: "  const handleDrop = (e: DragEvent<HTMLDivElement>, targetStage: OpportunityStage) => {\n    e.preventDefault();\n    const oppId = e.dataTransfer.getData(\'text/plain\');\n    if (!oppId) return;\n\n    const opp = opportunities.find(o => o.id === oppId);\n    if (!opp || opp.stage === targetStage) return;\n\n    // If moving OUT of QUALIFICATION, delete associated followups\n    if (opp.stage === \'QUALIFICATION\' && targetStage !== \'QUALIFICATION\') {\n      DataService.deleteFollowUpsByOpportunityId(opp.id);\n    }\n\n    if (targetStage === \'QUALIFICATION\') {\n      setPendingFollowUpOpp(opp);\n      setFollowUpTitle(`Follow up: ${opp.name}`);\n      setFollowUpType(\'CALL\');\n      setFollowUpDate(new Date().toISOString().split(\'T\')[0]);\n      setFollowUpNotes(\'\');\n      setShowFollowUpModal(true);\n      return;\n    }\n\n    executeMove(opp, targetStage);\n  };\n\n  const executeMove = (opp: Opportunity, targetStage: OpportunityStage) => {\n    const oldStageLabel = stages.find(s => s.key === opp.stage)?.label || opp.stage;\n    const newStageLabel = stages.find(s => s.key === targetStage)?.label || targetStage;\n\n    const updatedOpp = { ...opp, stage: targetStage, updatedAt: new Date().toISOString() };\n    DataService.saveOpportunity(updatedOpp);\n    \n    const activity = {\n      tenantId: opp.tenantId,\n      customerId: opp.customerId,\n      customerName: opp.customerName,\n      userId: currentUser?.id || \'SYS-001\',\n      userName: currentUser?.name || \'System\',\n      type: \'OPPORTUNITY\' as ActivityType,\n      subject: `Opportunity Stage Updated: ${targetStage}`,\n      description: `Opportunity \"${opp.name}\" was moved from ${oldStageLabel} to ${newStageLabel}.`,\n      occurredAt: new Date().toISOString(),\n      entityType: \'OPPORTUNITY\',\n      entityId: opp.id\n    };\n    DataService.addActivity(activity);\n\n    setOpportunities(DataService.getOpportunities(tenantId));\n  };\n\n  const handleCreateFollowUp = () => {\n    if (!pendingFollowUpOpp) return;\n    \n    // Create FollowUp entity\n    DataService.saveFollowUp({\n      id: `FU-${Date.now()}`,\n      tenantId,\n      title: followUpTitle,\n      customerId: pendingFollowUpOpp.customerId || \'\',\n      customerName: pendingFollowUpOpp.customerName || \'\',\n      customerCode: \'\',\n      picId: currentUser?.id || \'SYS-001\',\n      picName: currentUser?.name || \'System\',\n      type: followUpType,\n      status: \'SCHEDULED\',\n      followUpDate: followUpDate,\n      notes: followUpNotes,\n      relatedOpportunityId: pendingFollowUpOpp.id,\n      createdAt: new Date().toISOString()\n    });\n    \n    executeMove(pendingFollowUpOpp, \'QUALIFICATION\');\n\n    setShowFollowUpModal(false);\n    setPendingFollowUpOpp(null);\n  };"
    }
