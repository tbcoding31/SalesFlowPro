        replacement_content: "  // Close dropdown on outside click\n  useEffect(() => {\n    const handleClickOutside = (event: MouseEvent) => {\n      if (picDropdownRef.current && !picDropdownRef.current.contains(event.target as Node)) {\n        setIsPicDropdownOpen(false);\n      }\n    };\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  useEffect(() => {\n    if (id) {\n      const foundTask = allTasks.find(t => t.id === id);\n      if (foundTask) {\n        setTask(foundTask);\n        setTitle(foundTask.title);\n        setDescription(foundTask.description || \'\');\n        setCustomerId(foundTask.customerId || \'\');\n        setPicId(foundTask.picId);\n        setDueDate(foundTask.dueDate);\n        setPriority(foundTask.priority);\n        setStatus(foundTask.status);\n        // Will set related visits and opportunities after customer is set\n        setTimeout(() => {\n          setRelatedVisitId(foundTask.relatedVisitId || \'\');\n          setRelatedOpportunityId(foundTask.relatedOpportunityId || \'\');\n        }, 100);\n      }\n    }\n  }, [id, allTasks]);\n\n  // Filter visits and opportunities based on customer selection"
      }
      num_matches: 1
    }
  }
