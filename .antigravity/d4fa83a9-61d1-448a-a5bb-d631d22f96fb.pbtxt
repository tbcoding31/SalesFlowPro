          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const currentActiveCount = allTenantTasks.filter((tk) => tk.picId === currentPicUser.id && tk.status !== \'COMPLETED\' && tk.status !== \'CANCELLED\').length;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const currentOverdueCount = allTenantTasks.filter((tk) => tk.picId === currentPicUser.id && tk.dueDate < todayISO && tk.status !== \'COMPLETED\' && tk.status !== \'CANCELLED\').length;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const candidateUsers = tenantUsers.filter((u) => u.id !== currentPicUser.id && ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          u.name.toLowerCase().includes(reassignSearch.toLowerCase()) ||"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          (u.roleName && u.roleName.toLowerCase().includes(reassignSearch.toLowerCase())) ||"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          (u.department && u.department.toLowerCase().includes(reassignSearch.toLowerCase()))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const selectedNewPicUser = tenantUsers.find((u) => u.id === reassignTaskPicId);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const selectedActiveCount = selectedNewPicUser"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          ? allTenantTasks.filter((tk) => tk.picId === selectedNewPicUser.id && tk.status !== \'COMPLETED\' && tk.status !== \'CANCELLED\').length"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
