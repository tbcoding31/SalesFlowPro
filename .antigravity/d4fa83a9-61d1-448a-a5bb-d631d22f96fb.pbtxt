    instruction: "Add useSearchParams and category logic"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useMemo } from \'react\';\nimport { Link, useNavigate } from \'react-router-dom\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { DataService } from \'../../services/dataService\';\nimport { Task, Customer } from \'../../types\';\n\nexport const TasksPage: React.FC = () => {\n  const navigate = useNavigate();\n  const { currentTenant, currentUser } = useAuth();\n  const tenantId = currentTenant?.id || \'TEN-00001\';\n\n  const [tasks, setTasks] = useState<Task[]>(DataService.getTasks(tenantId));\n  const [customers] = useState<Customer[]>(DataService.getCustomers(tenantId));\n\n  // Filters"
        replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { Link, useNavigate, useSearchParams } from \'react-router-dom\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { DataService } from \'../../services/dataService\';\nimport { Task, Customer, Opportunity } from \'../../types\';\n\nexport const TasksPage: React.FC = () => {\n  const navigate = useNavigate();\n  const { currentTenant, currentUser } = useAuth();\n  const tenantId = currentTenant?.id || \'TEN-00001\';\n  const [searchParams, setSearchParams] = useSearchParams();\n\n  const [tasks, setTasks] = useState<Task[]>(DataService.getTasks(tenantId));\n  const [customers] = useState<Customer[]>(DataService.getCustomers(tenantId));\n  const [opportunities] = useState<Opportunity[]>(DataService.getOpportunities(tenantId));\n\n  // Main Categories\n  const activeCategory = searchParams.get(\'category\') || \'VISIT\';\n  const activeCustomer = searchParams.get(\'customer\') || \'ALL\';\n\n  const handleCategoryChange = (cat: string) => {\n    setSearchParams({ category: cat, customer: \'ALL\' });\n  };\n  const handleCustomerChange = (custId: string) => {\n    setSearchParams({ category: activeCategory, customer: custId });\n  };\n\n  // Extract companies that have opportunities\n  const opportunityCustomers = useMemo(() => {\n    const custIds = new Set(opportunities.map(o => o.customerId));\n    return customers.filter(c => custIds.has(c.id));\n  }, [opportunities, customers]);\n\n  // Filters"
      }
      num_matches: 1
    }
  }
}
