          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const selectedNewPicUser = tenantUsers.find((u) => u.id === reassignTaskPicId);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const selectedActiveCount = selectedNewPicUser"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          ? allTenantTasks.filter((tk) => tk.picId === selectedNewPicUser.id && tk.status !== \'COMPLETED\' && tk.status !== \'CANCELLED\').length"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
