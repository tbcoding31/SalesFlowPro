    instruction: "Change Tasks navlink to a grouped submenu"
    replacement_infos {
      original_chunk {
        target_content: "                <NavLink\n                  to=\"/tasks\"\n                  className={({ isActive }) =>\n                    `flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors ${\n                      isActive\n                        ? \'bg-[#e1dfff] text-[#09006b] font-semibold border-l-4 border-[#4744e5]\'\n                        : \'text-[#464555] hover:bg-[#f3f3f3] hover:text-[#1a1c1c]\'\n                    }`\n                  }\n                >\n                  <span className=\"material-symbols-outlined text-[20px]\">task_alt</span>\n                  <span>{isSalesRep ? \'My Tasks\' : \'Tasks\'}</span>\n                </NavLink>"
        replacement_content: "                <div>\n                  <NavLink\n                    to=\"/tasks\"\n                    className={() => {\n                      const isTasksActive = location.pathname.startsWith(\'/tasks\') || location.pathname.startsWith(\'/team-tasks\') || location.pathname.startsWith(\'/task-board\');\n                      return `flex items-center justify-between px-3 py-2 rounded-lg text-sm transition-colors ${\n                        isTasksActive\n                          ? \'bg-[#e1dfff] text-[#09006b] font-semibold border-l-4 border-[#4744e5]\'\n                          : \'text-[#464555] hover:bg-[#f3f3f3] hover:text-[#1a1c1c]\'\n                      }`;\n                    }}\n                  >\n                    <div className=\"flex items-center gap-3\">\n                      <span className=\"material-symbols-outlined text-[20px]\">assignment</span>\n                      <span>Tasks</span>\n                    </div>\n                    <span className=\"material-symbols-outlined text-[16px]\">expand_more</span>\n                  </NavLink>\n                  <div className=\"ml-7 mt-1 space-y-1\">\n                    <NavLink\n                      to=\"/tasks\"\n                      end\n                      className={({ isActive }) =>\n                        `block px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${\n                          isActive\n                            ? \'bg-[#6161ff] text-white\'\n                            : \'text-[#464555] hover:bg-[#f3f3f3] hover:text-[#1a1c1c]\'\n                        }`\n                      }\n                    >\n                      My Tasks\n                    </NavLink>\n                    \n                    {isManagerOrSupervisor && (\n                      <NavLink\n                        to=\"/team-tasks\"\n                        className={({ isActive }) =>\n                          `block px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${\n                            isActive\n                              ? \'bg-[#6161ff] text-white\'\n                              : \'text-[#464555] hover:bg-[#f3f3f3] hover:text-[#1a1c1c]\'\n                          }`\n                        }\n                      >\n                        Team Tasks\n                      </NavLink>\n                    )}\n\n                    <NavLink\n                      to=\"/task-board\"\n                      className={({ isActive }) =>\n                        `block px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${\n                          isActive\n                            ? \'bg-[#6161ff] text-white\'\n                            : \'text-[#464555] hover:bg-[#f3f3f3] hover:text-[#1a1c1c]\'\n                        }`\n                      }\n                    >\n                      Task Board\n                    </NavLink>\n                  </div>\n                </div>"
      }
      num_matches: 1
    }
  }
