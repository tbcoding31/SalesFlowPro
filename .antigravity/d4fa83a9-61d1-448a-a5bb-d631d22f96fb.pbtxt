All Activity Types</option>            <option value=\"VISIT_COMPLETED\">Visits Completed</option>            <option value=\"TASK_CREATED\">Tasks Created</option>            <option value=\"DEAL_STAGE_CHANGED\">Deal Stage Progressed</option>            <option value=\"FOLLOW_UP_LOGGED\">Follow-ups Logged</option>          </select>        </div>        <div className=\"text-xs text-[#767587]\">          Showing <span className=\"font-bold text-[#1a1c1c]\">{filtered.length}</span> recorded log entries        </div>      </div>      {/* Timeline Stream */}      <div className=\"bg-white rounded-xl border border-[#E1E1E1] shadow-sm p-6 space-y-4\">        <div className=\"space-y-4\">          {filtered.map((a) => (            <div key={a.id} className=\"p-4 bg-[#f9f9f9] rounded-xl border border-[#E1E1E1] flex items-start gap-4\">              <img                src={a.userAvatar || \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=facearea&facepad=2&w=256&h=256&q=80\'}                alt={a.userName}                className=\"w-10 h-10 rounded-full object-cover shrink-0 border border-[#E1E1E1]\"              />              <div className=\"flex-1 min-w-0\">                <div className=\"flex justify-between items-baseline\">                  <span className=\"font-bold text-sm text-[#1a1c1c] font-[\'Hanken_Grotesk\']\">{a.userName}</span>                  <span className=\"text-xs text-[#767587] font-mono\">{a.occurredAt}</span>                </div>                <div className=\"text-xs font-bold text-[#4744e5] mt-0.5\">                  {a.subject}                </div>                <p className=\"text-xs text-[#464555] mt-1 bg-white p-2.5 rounded border border-[#E1E1E1]\">                  {a.description}                </p>                {a.customerName && (                  <div className=\"mt-2 text-[11px] text-[#767587]\">                    Account Scope: <span className=\"font-bold text-[#1a1c1c]\">{a.customerName}</spa