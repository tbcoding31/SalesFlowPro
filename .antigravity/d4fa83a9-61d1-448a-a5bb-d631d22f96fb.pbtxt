          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            t.priority === \'URGENT\' ? \'bg-rose-100 text-rose-700\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
