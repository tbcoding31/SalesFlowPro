etween items-start sm:items-center gap-4\">          <h2 className=\"font-bold text-base text-[#1a1c1c] font-[\'Hanken_Grotesk\']\">            Team Overview          </h2>          <div className=\"relative w-full sm:w-64\">            <span className=\"material-symbols-outlined text-[18px] text-[#767587] absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\">              search            </span>            <input              type=\"text\"              placeholder=\"Search team member...\"              value={searchQuery}              onChange={(e) => {                setSearchQuery(e.target.value);                setCurrentPage(1);              }}              className=\"w-full pl-9 pr-3 py-1.5 bg-[#f9f9f9] border border-[#E1E1E1] rounded-lg text-xs text-[#1a1c1c] placeholder-[#767587] focus:outline-none focus:border-[#4744e5] focus:bg-white\"            />          </div>        </div>        {/* Table */}        <div className=\"overflow-x-auto\">          <table className=\"w-full text-left text-xs text-[#1a1c1c]\">            <thead className=\"bg-white text-[#464555] font-bold uppercase border-b border-[#E1E1E1] tracking-wider text-[10px] font-[\'Hanken_Grotesk\']\">              <tr>                <th className=\"px-5 py-3.5\">EMPLOYEE</th>                <th className=\"px-4 py-3.5 text-center\">ACTIVE TASKS</th>                <th className=\"px-4 py-3.5 text-center\">OVERDUE</th>                <th className=\"px-4 py-3.5 text-center\">TODAY\'S VISITS</th>                <th className=\"px-4 py-3.5 text-center\">FOLLOW-UPS</th>                <th className=\"px-4 py-3.5 text-center\">OPPS</th>                <th className=\"px-4 py-3.5 text-center\">WORKLOAD</th>                <th className=\"px-5 py-3.5 text-right\">ACTIONS</th>              </tr>            </thead>            <tbody className=\"divide-y divide-[#E1E1E1]\">              {paginatedMembers.length === 0 ? (                <tr>                  <td colSpan={8} className=\"px-5 py-8 text-center text-xs text-[#767587]\">                    No team members found.                  </td>                </tr>              ) : (                paginatedMembers.map((member) => (                  <tr key={member.id} className=\"hover:bg-[#f9f9f9] transition-colors\">                    <td className=\"px-5 py-4\">                      <div className=\"flex items-center gap-3\">                        <div                          className={`w-9 h-9 rounded-full ${member.avatarBg} text-white font-bold text-xs flex items-center justify-center shrink-0`}                        >                          {member.avatarText}                        </div>                        <div>                          <div className=\"font-bold text-xs text-[#1a1c1c] font-[\'Hanken_Grotesk\']\">                            {member.name}                          </div>                          <div className=\"text-[11px] text-[#767587]\">                            {member.role}                          </div>                        </div>                      </div>                    </td>                    <td className=\"px-4 py-4 text-center font-medium text-[#1a1c1c]\">                      {member.activeTasks}                    </td>                    <td className=\"px-4 py-4 text-center font-bold\">                      <span className={member.overdue > 0 ? \'text-[#d92d20]\' : \'text-[#1a1c1c]\'}>                        {member.overdue}                      </span>                    </td>                    <td className=\"px-4 py-4 text-center font-medium text-[#1a1c1c]\">                      {member.todaysVisits}                    </td>                    <td className=\"px-4 py-4 text-center font-medium text-[#1a1c1c]\">                      {member.followups}                    </td>                    <td className=\"px-4 py-4 text-center font-medium text-[#1a1c1c]\">                      {member.opps}                    </td>                    <td className=\"px-4 py-4 text-center\">                      <span                        className={`px-2.5 py-1 text-[10px] font-bold uppercase rounded-md tracking-wider ${                          member.workload === \'HIGH\'                            ? \'bg-[#ffe4e4] text-[#d92d20]\'                            : \'bg-[#f3f3f3] text-[#464555]\'                        }`}                      >                        {member.workload}                      </span>                    </td>                    <td className=\"px-5 py-4 text-right\">                      <Link                        to={`/performance`}                        className=\"text-xs font-bold text-[#3b38e0] hover:text-[#2c24ce] inline-flex items-center gap-0.5\"                      >                        <span>View</span>                        <span className=\"material-symbols-outlined text-[14px]\">chevron_right</span>                      </Link>                    </td>                  </tr>                ))              )}            </tbody>          </table>        </div>        {/* Footer Pagination */}        <div className=\"p-4 bg-[#f9f9f9] border-t border-[#E1E1E1] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#767587]\">          <div>            Showing {totalMembers > 0 ? startIndex + 1 : 0} to{\' \'}            {Math.min(startIndex + itemsPerPage, totalMembers)} of {totalMembers} members          </div>          <div className=\"flex items-center gap-2\">            <button              onClick={() => setCurrentPage((p) => Math.max(p - 1, 1))}              disabled={currentPage === 1}              className=\"px-3 py-1.5 bg-white border border-[#E1E1E1] rounded-lg text-xs font-medium text-[#1a1c1c] disabled:opacity-40 disabled:cursor-not-allowed hover:bg-[#f3f3f3]\"            >              Previous            </button>            <button              onClick={() => setCurrentPage((p) => Math.min(p + 1, totalPages))}              disabled={currentPage === totalPages || totalPages === 0}              className=\"px-3 py-1.5 bg-white border border-[#E1E1E1] rounded-lg text-xs font-medium text-[#1a1c1c] disabled:opacity-40 disabled:cursor-not-allowed hover:bg-[#f3f3f3]\"            >              Next            </button>          </div>        </div>      </div>    </div>  );};"
