        target_content: "// Dynamic Dashboard Resolver component based on user role\nconst DashboardResolver: React.FC = () => {\n  const { currentUser } = useAuth();\n  const isSuperAdmin = currentUser?.role === \'SUPER_ADMIN\' || currentUser?.tenantId === \'SYSTEM\';\n\n  if (isSuperAdmin) {\n    return <SuperAdminDashboard />;\n  }\n\n  return <TeamDashboard />;\n};"
        replacement_content: "// Dynamic Dashboard Resolver component based on user role\nconst DashboardResolver: React.FC = () => {\n  const { currentUser } = useAuth();\n  const isSuperAdmin = currentUser?.role === \'SUPER_ADMIN\' || currentUser?.tenantId === \'SYSTEM\';\n\n  if (isSuperAdmin) {\n    return <SuperAdminDashboard />;\n  }\n\n  if (currentUser?.role === \'SALES_REPRESENTATIVE\') {\n    return <SalesDashboard />;\n  }\n\n  return <TeamDashboard />;\n};"
      }
