        lines {
          text: "      {reassigningTask && (() => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const allTenantTasks = DataService.getTasks(tenantId);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const currentPicUser = tenantUsers.find((u) => u.id === reassigningTask.picId) || {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          id: reassigningTask.picId,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
