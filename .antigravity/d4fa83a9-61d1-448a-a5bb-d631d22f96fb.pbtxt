    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useMemo } from \'react\';\nimport { Link, useNavigate } from \'react-router-dom\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { DataService } from \'../../services/dataService\';\nimport { Task, Customer, TaskStatus } from \'../../types\';\n\nexport const TaskBoardPage: React.FC = () => {\n  const navigate = useNavigate();\n  const { currentTenant, currentUser } = useAuth();\n  const tenantId = currentTenant?.id || \'TEN-00001\';\n\n  const [tasks, setTasks] = useState<Task[]>(DataService.getTasks(tenantId));\n  const [customers] = useState<Customer[]>(DataService.getCustomers(tenantId));\n\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [customerFilter, setCustomerFilter] = useState(\'ALL\');\n  const [picFilter, setPicFilter] = useState(\'ALL\');\n  const [priorityFilter, setPriorityFilter] = useState(\'ALL\');\n  const [dueDateFilter, setDueDateFilter] = useState(\'\');\n\n  // Extract unique PICs from tasks\n  const uniquePics = useMemo(() => {\n    const pics = new Map();\n    tasks.forEach(t => {\n      if (!pics.has(t.picId)) {\n        pics.set(t.picId, { id: t.picId, name: t.picName, avatar: t.picAvatar });\n      }\n    });\n    return Array.from(pics.values());\n  }, [tasks]);\n\n  const filteredTasks = useMemo(() => {\n    return tasks.filter((t) => {\n      if (searchQuery && !t.title.toLowerCase().includes(searchQuery.toLowerCase())) return false;\n      if (customerFilter !== \'ALL\' && t.customerId !== customerFilter) return false;\n      if (picFilter !== \'ALL\' && t.picId !== picFilter) return false;\n      if (priorityFilter !== \'ALL\' && t.priority !== priorityFilter) return false;\n      if (dueDateFilter && t.dueDate !== dueDateFilter) return false;\n      return true;\n    });\n  }, [tasks, searchQuery, customerFilter, picFilter, priorityFilter, dueDateFilter]);"
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { Link, useNavigate, useSearchParams, useLocation } from \'react-router-dom\';\nimport { useAuth } from \'../../context/AuthContext\';\nimport { DataService } from \'../../services/dataService\';\nimport { Task, Customer, TaskStatus, Opportunity } from \'../../types\';\n\nexport const TaskBoardPage: React.FC = () => {\n  const navigate = useNavigate();\n  const location = useLocation();\n  const { currentTenant, currentUser } = useAuth();\n  const tenantId = currentTenant?.id || \'TEN-00001\';\n  const [searchParams, setSearchParams] = useSearchParams();\n\n  const [tasks, setTasks] = useState<Task[]>(DataService.getTasks(tenantId));\n  const [customers] = useState<Customer[]>(DataService.getCustomers(tenantId));\n  const [opportunities] = useState<Opportunity[]>(DataService.getOpportunities(tenantId));\n\n  // Main Categories\n  const activeCategory = searchParams.get(\'category\') || \'VISIT\';\n  const activeCustomer = searchParams.get(\'customer\') || \'ALL\';\n\n  const handleCategoryChange = (cat: string) => {\n    setSearchParams({ category: cat, customer: \'ALL\' });\n  };\n  const handleCustomerChange = (custId: string) => {\n    setSearchParams({ category: activeCategory, customer: custId });\n  };\n\n  // Extract companies that have opportunities\n  const opportunityCustomers = useMemo(() => {\n    const custIds = new Set(opportunities.map(o => o.customerId));\n    return customers.filter(c => custIds.has(c.id));\n  }, [opportunities, customers]);\n\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [customerFilter, setCustomerFilter] = useState(\'ALL\');\n  const [picFilter, setPicFilter] = useState(\'ALL\');\n  const [priorityFilter, setPriorityFilter] = useState(\'ALL\');\n  const [dueDateFilter, setDueDateFilter] = useState(\'\');\n\n  // Extract unique PICs from tasks\n  const uniquePics = useMemo(() => {\n    const pics = new Map();\n    tasks.forEach(t => {\n      if (!pics.has(t.picId)) {\n        pics.set(t.picId, { id: t.picId, name: t.picName, avatar: t.picAvatar });\n      }\n    });\n    return Array.from(pics.values());\n  }, [tasks]);\n\n  const filteredTasks = useMemo(() => {\n    return tasks.filter((t) => {\n      // Category logic: VISIT vs OPPORTUNITY\n      if (activeCategory === \'VISIT\') {\n        if (!t.relatedVisitId && t.taskType !== \'Visit\') return false;\n      } else if (activeCategory === \'OPPORTUNITY\') {\n        if (!t.relatedOpportunityId && t.taskType !== \'Opportunity\') return false;\n        if (activeCustomer !== \'ALL\' && t.customerId !== activeCustomer) return false;\n      }\n\n      if (searchQuery && !t.title.toLowerCase().includes(searchQuery.toLowerCase())) return false;\n      if (customerFilter !== \'ALL\' && t.customerId !== customerFilter) return false;\n      if (picFilter !== \'ALL\' && t.picId !== picFilter) return false;\n      if (priorityFilter !== \'ALL\' && t.priority !== priorityFilter) return false;\n      if (dueDateFilter && t.dueDate !== dueDateFilter) return false;\n      return true;\n    });\n  }, [tasks, searchQuery, customerFilter, picFilter, priorityFilter, dueDateFilter, activeCategory, activeCustomer]);"
    }
