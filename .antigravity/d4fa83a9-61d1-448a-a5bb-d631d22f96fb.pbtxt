      target_content: "  getMasterData: (category?: MasterDataItem[\'category\']): MasterDataItem[] => {\n    const items = getLocal(STORAGE_KEYS.MASTER_DATA, INITIAL_MASTER_DATA);\n    if (category) {\n      return items.filter((i) => i.category === category).sort((a, b) => a.displayOrder - b.displayOrder);\n    }\n    return items;\n  },"
      replacement_content: "  getMasterData: (category?: MasterDataItem[\'category\']): MasterDataItem[] => {\n    const items = getLocal(STORAGE_KEYS.MASTER_DATA, INITIAL_MASTER_DATA);\n    \n    // Auto-merge newly added initial master data that might not be in existing localStorage\n    const existingIds = new Set(items.map((i: any) => i.id));\n    let hasNewItems = false;\n    for (const initialItem of INITIAL_MASTER_DATA) {\n      if (!existingIds.has(initialItem.id)) {\n        items.push(initialItem);\n        hasNewItems = true;\n      }\n    }\n    \n    if (hasNewItems) {\n      setLocal(STORAGE_KEYS.MASTER_DATA, items);\n    }\n\n    if (category) {\n      return items.filter((i) => i.category === category).sort((a, b) => a.displayOrder - b.displayOrder);\n    }\n    return items;\n  },"
    }
